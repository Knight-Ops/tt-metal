{
  "name": "qwen3.6-a3b-blackhole",
  "arch": "blackhole",
  "platform": {
    "ttnn": ">=0.77"
  },
  "target": "p150",
  "mesh": {
    "devices": 1,
    "topology": "1x1"
  },
  "entrypoint": {
    "class": "models.qwen3_6_a3b.generator_vllm:Qwen36ForCausalLM",
    "arch_name": "Qwen3_5MoeForConditionalGeneration"
  },
  "weights": {
    "repo": "Qwen/Qwen3.6-35B-A3B"
  },
  "capabilities": {
    "tool_parser": "qwen3_coder",
    "reasoning_parser": "qwen3"
  },
  "resources": {
    "max_num_seqs": 1,
    "block_size": 64,
    "command_override": {
      "default": [
        "python3",
        "-m",
        "vllm.entrypoints.openai.api_server",
        "--model",
        "Qwen/Qwen3.6-35B-A3B",
        "--max-num-seqs",
        "1",
        "--block-size",
        "64",
        "--additional-config",
        "{\"tt\": {\"sample_on_device_mode\": \"decode_only\"}}",
        "--reasoning-parser",
        "qwen3",
        "--enable-auto-tool-choice",
        "--tool-call-parser",
        "qwen3_coder",
        "--override-generation-config",
        "{\"temperature\": 0.6, \"top_p\": 0.95, \"top_k\": 20}",
        "--port",
        "8000"
      ]
    }
  },
  "env": {
    "MESH_DEVICE": "P150",
    "HF_MODEL": "Qwen/Qwen3.6-35B-A3B",
    "QWEN36_EXPERT_DTYPE": "bf4",
    "QWEN36_MAX_SEQ": "131072",
    "QWEN36_CB_SLOT_MARGIN": "0",
    "QWEN36_GDN_FUSED_OP": "1",
    "VLLM_RPC_TIMEOUT": "100000"
  }
}
